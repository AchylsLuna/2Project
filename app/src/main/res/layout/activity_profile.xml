<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/container"
    tools:context=".ProfileActivity">



    <!--Profile Picture -->
    <ImageView
        android:id="@+id/profileImage"
        android:layout_width="172dp"
        android:layout_height="176dp"
        android:layout_marginTop="52dp"
        android:clickable="true"
        android:focusable="true"
        android:scaleType="centerCrop"
        android:src="@drawable/profile_con"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- Upload Button -->

    <Button
        android:id="@+id/btnUploadProfilePic"
        android:layout_width="262dp"
        android:layout_height="54dp"
        android:layout_marginStart="90dp"
        android:layout_marginEnd="176dp"
        android:backgroundTint="@color/green"
        android:padding="8dp"
        android:text="Upload Profile Picture"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.136"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profileImage" />

    <TextView
        android:id="@+id/profileName"
        android:layout_width="333dp"
        android:layout_height="48dp"
        android:layout_marginBottom="19dp"
        android:gravity="center"
        android:text="Username"
        android:textColor="@color/black"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/profileDetails"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnUploadProfilePic" />

    <TextView
        android:id="@+id/profileDetails"
        android:layout_width="359dp"
        android:layout_height="139dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="19dp"
        android:background="@drawable/container"
        android:gravity="start|top"
        android:inputType="textMultiLine"
        android:lineSpacingExtra="10dp"
        android:maxLines="5"
        android:minLines="5"
        android:padding="16dp"
        android:scrollbars="vertical"
        android:text="Scholarship Type: \nYear Level \nCourse: \nDepartment:"
        android:textColor="@color/black"
        android:textColorHint="@color/black"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profileName" />

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#F44336"
        android:padding="10dp"
        android:text="@string/logout"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>